# 静态资源长期缓存：图片/字体文件名稳定（内容变更时换文件名），
# 让浏览器本地缓存，避免每次访问重复下载大图
/pics/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 与文章 JSON 不缓存（确保改版/发文后立即生效）
/index.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/articles/*
  Cache-Control: no-cache
